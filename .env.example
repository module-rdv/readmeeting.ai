# APP_URL is deployment metadata; Vite does not read it directly.
APP_URL="http://localhost:3000"

# ==========================================
# MICROSOFT ENTRA ID (AZURE AD) - DGF TENANT
# ==========================================
# ID d'application (client) généré lors de l'enregistrement de l'App dans Entra ID
VITE_AZURE_CLIENT_ID=""

# ID de l'annuaire (tenant) du locataire DGF (ex: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_AZURE_TENANT_ID=""

# URI de redirection locale de type SPA, également enregistrée dans Entra ID
VITE_AZURE_REDIRECT_URI="http://localhost:3000/redirect.html"

# URL de l'API ASP.NET Core ; en local, lancer l'API sur le port 5000.
# L'ancienne variable VITE_READMEETING_API_BASE_URL reste acceptée.
VITE_API_BASE_URL="http://localhost:5000"

# Scope délégué exact à obtenir de la configuration de l'inscription API Entra.
# Laisser vide jusqu'à confirmation par l'administrateur.
VITE_READMEETING_API_SCOPE=""

# Conservé pour référence ; les scopes Graph sont définis dans msalConfig.ts.
VITE_GRAPH_SCOPES="User.Read Calendars.Read OnlineMeetings.Read OnlineMeetingTranscript.Read.All"

# Fenêtre de chargement initiale du calendrier Graph (1 à 730 jours).
# Les pages Réunions et Calendrier peuvent ensuite charger d'autres périodes.
VITE_MEETINGS_PAST_DAYS="180"
VITE_MEETINGS_FUTURE_DAYS="365"
